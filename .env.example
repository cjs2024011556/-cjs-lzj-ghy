# ============================================
# A1 设备检修智能系统 - 本地开发环境配置
# 复制为 .env 并填入实际值（.env 在 .gitignore 中）
# ============================================

# ---- 应用基础配置 ----
APP_NAME=A1-Maintenance-System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=dev-only-not-for-production

# ---- 模型配置（双模式）----
LLM_MODE=cloud

# ---- 阿里云百炼平台（云端 API）----
# ⚠️ 必填：去 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=<your-bailian-key>
# 兼容 OpenAI 协议（便于切本地推理 / OpenAI 兼容服务）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.1

# ---- 本地模型（降级用，LoongArch + 麒麟）----
LOCAL_MODEL_PATH=/opt/models/Qwen2-VL-7B-Instruct
LOCAL_MODEL_BACKEND=transformers
LOCAL_MODEL_DEVICE=cpu

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=a1_user
POSTGRES_PASSWORD=a1_password
POSTGRES_DB=a1_maintenance

# ---- Milvus（向量库）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=milvus_password
MILVUS_DB=default

# ---- Neo4j（故障图谱）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ---- MinIO（对象存储）----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=a1-uploads
MINIO_SECURE=false

# ---- Embedding ----
# 默认 BAAI/bge-m3（1024 维）；支持 text-embedding-v3（自定义 dim 64-1024）
# 切到 text-embedding-v2 是 1536 维，重启后 Milvus 会自动重建 collection
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# ---- 文件上传 ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,bmp,webp
ALLOWED_DOC_TYPES=pdf,docx,doc,txt,md

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- 业务参数 ----
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
# 百炼 rerank 模型（gte-rerank / gte-rerank-v2 / qwen3-rerank）
# 关闭 RERANK_ENABLED 可降级到 cosine 顺序
RERANK_MODEL=gte-rerank
RERANK_ENABLED=true
LLM_TIMEOUT_SEC=60
EMBEDDING_BATCH_SIZE=16