# ============================================
# A1 璁惧妫€淇櫤鑳界郴缁?- 鏈湴寮€鍙戠幆澧冮厤缃?# ============================================

# ---- 搴旂敤鍩虹閰嶇疆 ----
APP_NAME=A1-Maintenance-System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=dev-only-not-for-production

# ---- 妯″瀷閰嶇疆锛堝弻妯″紡锛?----
LLM_MODE=cloud

# ---- 闃块噷浜戠櫨鐐煎钩鍙帮紙浜戠 API锛?---
# 鈿狅笍 蹇呭～锛氬幓 https://bailian.console.aliyun.com/ 鐢宠
DASHSCOPE_API_KEY=<your-bailian-key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.1

# ---- 鏈湴妯″瀷锛堥檷绾х敤锛?----
LOCAL_MODEL_PATH=/opt/models/Qwen2-VL-7B-Instruct
LOCAL_MODEL_BACKEND=transformers
LOCAL_MODEL_DEVICE=cpu

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=a1_user
POSTGRES_PASSWORD=a1_password
POSTGRES_DB=a1_maintenance

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=milvus_password
MILVUS_DB=default

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=a1-uploads
MINIO_SECURE=false

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# ---- 鏂囦欢涓婁紶 ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,bmp,webp
ALLOWED_DOC_TYPES=pdf,docx,doc,txt,md

# ---- 鏃ュ織 ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- 涓氬姟鍙傛暟 ----
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
# U2: 鐧剧偧 rerank 妯″瀷锛坓te-rerank / gte-rerank-v2 / qwen3-rerank锛?RERANK_MODEL=gte-rerank
RERANK_ENABLED=true
LLM_TIMEOUT_SEC=60
EMBEDDING_BATCH_SIZE=16

